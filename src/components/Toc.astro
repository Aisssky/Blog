---
/**
 * 文章侧边索引。
 * 旧站三个长文页各自手写了一份 <ul> 目录；这里改为按渲染后的
 * h2 / h3 自动生成，新增文章或改动标题后不需要再手工维护目录。
 *
 * 手机端目录项可达数百条，全部平铺会把正文推到屏幕外；
 * 这里用一个纯 CSS 的折叠开关（checkbox + label），桌面端始终展开。
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  label?: string;
}

const { headings, label = '📌 索引' } = Astro.props;
---

<h3 class="toc-title">{label}</h3>
<input class="toc-toggle" type="checkbox" id="toc-toggle" aria-label="展开或收起目录" />
<label class="toc-toggle-label" for="toc-toggle">
  <span>{label}</span>
  <span class="toc-arrow" aria-hidden="true">⌄</span>
</label>
<ul class="toc-list">
  {
    headings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class={heading.depth >= 3 ? 'sub-link toc-link' : 'toc-link'}
          data-depth={heading.depth}
        >
          {heading.text}
        </a>
      </li>
    ))
  }
</ul>
