---
/**
 * 黑盒 / 白盒测试方法速查。
 * 多张分表（黑盒概述、六方法、方法选择、白盒概述、基本路径、逻辑覆盖、覆盖对照、插桩），
 * 内容全部来自 src/data/testing-methods-matrix.ts，逐字取自长文原文。
 * 表格可横向滚动 + 首列吸左；窄屏降级成卡片。
 */
import { TESTING_TABLES, rich } from '../data/testing-methods-matrix';
---

<div class="testing-matrix">
  {
    TESTING_TABLES.map((table) => {
      // fr 列宽换算成百分比，交给原生 table 的 colgroup
      const frs = table.columns.map((c) => parseFloat(c.width));
      const total = frs.reduce((a, b) => a + b, 0);
      return (
      <section class="tm-section" id={table.id}>
        <h2 class="tm-title">{table.title}</h2>
        <div class="tm-scroll">
          <table class="tm-table">
            <colgroup>
              {frs.map((f) => <col style={`width:${(f / total * 100).toFixed(2)}%`} />)}
            </colgroup>
            <thead>
              {table.columns.map((col) => (
                <th scope="col">{col.name}</th>
              ))}
            </thead>
            <tbody>
              {
                table.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) => (
                      <td
                        class={i === 0 ? 'tm-key' : ''}
                        data-label={table.columns[i]?.name ?? ''}
                        set:html={rich(cell)}
                      />
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
      );
    })
  }
</div>

<style>
  .testing-matrix {
    margin: 24px 0 30px;
  }

  .tm-section {
    margin: 0 0 38px;
  }

  .tm-title {
    font-size: 20px !important;
    font-weight: 700;
    color: #222 !important;
    margin: 0 0 12px !important;
    padding: 0 0 8px !important;
    border-bottom: 2px solid #f0f0f0 !important;
  }

  .tm-scroll {
    overflow-x: auto;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 12px;
    background: #fff;
  }

  /* 原生 table 布局：列宽交给 colgroup 百分比，长文本自动换行，宽度受控 */
  .tm-table {
    display: table !important;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 0 !important;
    font-size: 13.5px;
    overflow: visible !important;
  }

  .tm-table th,
  .tm-table td {
    border: none !important;
    border-bottom: 1px solid #efefef !important;
    border-right: 1px solid #f2f2f2 !important;
    padding: 12px 14px !important;
    vertical-align: top;
    text-align: left;
    background: #fff;
    font-size: 13.5px;
    line-height: 1.75;
    color: #444;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .tm-table th:last-child,
  .tm-table td:last-child {
    border-right: none !important;
  }

  .tm-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #fafafa !important;
    font-weight: 600;
    color: #666;
    font-size: 13px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border-bottom: 1px solid #e5e5e5 !important;
  }

  .tm-table .tm-key {
    position: sticky;
    left: 0;
    z-index: 1;
    background: #fbfbfb !important;
    font-weight: 700;
    color: #c2185b;
    white-space: nowrap;
    border-right: 1px solid #e5e5e5 !important;
  }

  .tm-table thead th:first-child {
    z-index: 3;
  }

  .tm-table tbody tr:hover td {
    background: #fcf7f9 !important;
  }

  .tm-table :global(strong) {
    color: #222;
    font-weight: 700;
  }

  /* 长文本拆成的分条短行 */
  .tm-table :global(.tm-line) {
    margin: 0 0 7px;
  }

  .tm-table :global(.tm-line:last-child) {
    margin-bottom: 0;
  }

  /* 编号项：编号悬挂，正文对齐 */
  .tm-table :global(.tm-num) {
    padding-left: 1.6em;
    text-indent: -1.6em;
  }

  /* 实例标题：与上文拉开一点距离 */
  .tm-table :global(.tm-eg) {
    margin-top: 10px;
  }

  /* 窄屏：表格退成纵向卡片 */
  @media (max-width: 760px) {
    .tm-scroll {
      overflow-x: visible;
      border: none;
      background: transparent;
    }

    .tm-table {
      display: block !important;
      width: 100%;
    }

    .tm-table thead,
    .tm-table th {
      display: none !important;
    }

    .tm-table tbody {
      display: block;
    }

    .tm-table tr {
      display: block;
      border: 1px solid #ececec;
      border-radius: 10px;
      background: #fff;
      margin-bottom: 12px;
      padding: 6px 0;
    }

    .tm-table td {
      display: block;
      position: static !important;
      border: none !important;
      white-space: normal !important;
      padding: 8px 14px !important;
    }

    .tm-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 11.5px;
      font-weight: 600;
      color: #999;
      margin-bottom: 3px;
    }

    .tm-table td.tm-key {
      font-size: 15px;
      color: #c2185b;
      border-bottom: 1px dashed #eee !important;
      padding-bottom: 10px !important;
    }

    .tm-table td.tm-key::before {
      display: none;
    }
  }

  @media print {
    .tm-scroll {
      overflow: visible;
      border: none;
    }

    .tm-table {
      font-size: 9.5px;
    }
  }
</style>
