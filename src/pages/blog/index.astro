---
/**
 * Writing 首页 /blog/
 *
 * 信息架构入口：四个一级分区卡片 + 最近更新（跨越全部分区）+ 侧栏（分类 / 标签云）。
 */
import PageLayout from '../../components/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionCard from '../../components/SectionCard.astro';
import { getPublishedPosts, collectTags } from '../../lib/posts';
import { SECTIONS } from '../../data/sections';
import { groupBySection, activeCategories } from '../../lib/taxonomy';
import { sectionPath, tagPath, withBase } from '../../lib/site';
import '../../styles/writing.css';

const posts = await getPublishedPosts();

/** 分区 id → 该分区文章，用于卡片标签和侧栏计数 */
const bySection = new Map(groupBySection(posts).map((g) => [g.section.id, g.posts]));

const tags = collectTags(posts);

/** 最近更新：取最新 8 篇，跨全部分区 */
const RECENT_COUNT = 8;
const recent = posts.slice(0, RECENT_COUNT);
---

<PageLayout
  title="Writing"
  description="知识整理、工程实践与个人记录。"
  subtitle="知识整理、工程实践与个人记录。"
>
  <!-- 一级分区入口 -->
  <div class="writing-grid">
    {
      SECTIONS.map((section, i) => {
        const bucket = bySection.get(section.id) ?? [];
        return <SectionCard section={section} index={i} categories={activeCategories(bucket)} />;
      })
    }
  </div>

  <div class="writing-layout">
    <div class="writing-main">
      <!-- 最近更新：跨全部分区 -->
      <section class="writing-panel">
        <div class="writing-panel-head">
          <h2 class="writing-panel-title">最近更新</h2>
          <a class="writing-view-all" href={withBase('/blog/all/')}>查看全部 →</a>
        </div>

        {
          recent.length > 0 ? (
            <ul class="post-list">
              {recent.map((post) => <PostCard post={post} />)}
            </ul>
          ) : (
            <div class="writing-empty">还没有文章。</div>
          )
        }
      </section>
    </div>

    <aside class="writing-side">
      <!-- 文章分类：四个一级分区 -->
      <section class="writing-panel">
        <h2 class="writing-panel-title">文章分类</h2>
        <div class="section-links">
          {
            SECTIONS.map((section) => (
              <a class="section-link" href={sectionPath(section.id)}>
                <span>{section.name}</span>
                <span class="count">{bySection.get(section.id)?.length ?? 0}</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- 标签云 -->
      {
        tags.length > 0 && (
          <section class="writing-panel">
            <h2 class="writing-panel-title">标签</h2>
            <div class="tag-cloud">
              {tags.map((tag) => (
                <a class="tag-chip" href={tagPath(tag.name)}>#{tag.name}</a>
              ))}
            </div>
          </section>
        )
      }
    </aside>
  </div>
</PageLayout>

{/*
  站长入口：仅加载极小的引导脚本，动态 import 编辑器控制器。
  Tiptap / Fabric 等重依赖只有在真正进入编辑模式后才会按需下载，
  普通访客的阅读体验、加载速度与 SEO 不受影响。
*/}
<script>
  import('../../scripts/editor/owner')
    .then((m) => m.initEditor())
    .catch((e) => console.error('[editor] 初始化失败', e));
</script>
