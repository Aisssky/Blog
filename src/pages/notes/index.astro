---
/**
 * 随记列表页 /notes/ —— 整页内容加密，输入密码后才显示。
 *
 * 构建时把列表渲染成 HTML 并用 AES-GCM 加密，页面里只留密文和解锁 UI；
 * 前端 WebCrypto 用输入的密码解密后注入 DOM。密码错则校验失败，拿不到明文。
 * 注意：这是前端锁，只挡「不查源码」的普通访客，不是真正的访问控制。
 */
import PageLayout from '../../components/PageLayout.astro';
import NotesListContent from '../../components/NotesListContent.astro';
import { getCollection, render } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { encryptNotes } from '../../lib/notes-crypto';
import { NOTES_PASSCODE } from '../../lib/notes-passcode';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  // 时间正序：早的在上、新的在下（新增随记追加到列表末尾）
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);

const rendered = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);

// 用容器把列表组件渲染成 HTML 字符串，再整体加密
const container = await AstroContainer.create();
const listHtml = await container.renderToString(NotesListContent, { props: { rendered } });
const cipher = encryptNotes(listHtml, NOTES_PASSCODE);
---

<PageLayout title="随记" description="游戏开发之外的随手记录">
  <div class="page-glass">
    <div id="notes-lock" class="notes-lock" data-cipher={cipher}>
      <div class="lock-icon" aria-hidden="true">🔒</div>
      <h1 class="lock-title">随记已加密</h1>
      <p class="lock-hint">输入密码查看内容。</p>
      <form id="notes-lock-form" class="lock-form" autocomplete="off">
        <input
          id="notes-pass-input"
          class="lock-input"
          type="password"
          name="passcode"
          placeholder="密码"
          aria-label="随记访问密码"
          autocomplete="current-password"
          required
        />
        <button class="lock-btn" type="submit">解锁</button>
      </form>
      <p id="notes-lock-error" class="lock-error" role="alert" hidden>密码不对，再试试。</p>
    </div>
    <div id="notes-vault" class="notes-vault" hidden></div>
  </div>
</PageLayout>

<script is:inline define:vars={{}}>
  (async () => {
    const lock = document.getElementById('notes-lock');
    const vault = document.getElementById('notes-vault');
    const form = document.getElementById('notes-lock-form');
    const input = document.getElementById('notes-pass-input');
    const error = document.getElementById('notes-lock-error');
    if (!lock || !vault || !form || !input || !error) return;

    const b64 = lock.dataset.cipher || '';
    const bytes = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
    const iv = bytes.slice(0, 12);
    const ciphertext = bytes.slice(12);

    async function tryUnlock(pass) {
      try {
        const keyBytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pass));
        const key = await crypto.subtle.importKey('raw', keyBytes, 'AES-GCM', false, ['decrypt']);
        const plain = await crypto.subtle.decrypt(
          { name: 'AES-GCM', iv, tagLength: 128 },
          key,
          ciphertext,
        );
        vault.innerHTML = new TextDecoder().decode(plain);
        lock.hidden = true;
        vault.hidden = false;
        return true;
      } catch {
        return false;
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const ok = await tryUnlock(input.value);
      error.hidden = ok;
      if (!ok) {
        input.select();
      }
    });
  })();
</script>

<style is:global>
  /* 玻璃面板 */
  .page-glass {
    background: var(--c-glass);
    backdrop-filter: blur(18px) saturate(120%);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 26px 28px;
  }

  /* 解锁界面 */
  .notes-lock {
    text-align: center;
    padding: 48px 16px 56px;
  }

  .lock-icon {
    font-size: 34px;
    line-height: 1;
    margin-bottom: 14px;
  }

  .lock-title {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 700;
    color: #222;
  }

  .lock-hint {
    margin: 0 0 24px;
    font-size: 14px;
    color: #777;
  }

  .lock-form {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .lock-input {
    width: 220px;
    max-width: 100%;
    padding: 10px 14px;
    font-family: var(--ff-sans);
    font-size: 14px;
    color: #333;
    background: #fff;
    border: 1px solid var(--c-border, #d9e2ee);
    border-radius: 999px;
    outline: none;
    transition: border-color 0.18s ease;
  }

  .lock-input:focus {
    border-color: var(--c-accent, #6289c7);
  }

  .lock-btn {
    padding: 10px 24px;
    font-family: var(--ff-sans);
    font-size: 14px;
    color: #fff;
    background: var(--c-accent, #6289c7);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.18s ease;
  }

  .lock-btn:hover {
    opacity: 0.9;
  }

  .lock-error {
    margin: 14px 0 0;
    font-size: 13px;
    color: #c2185b;
  }

  /* 随记列表（由前端解密后注入，故用全局样式） */
  .note-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note-item {
    padding: 18px 4px;
    border-top: 1px solid var(--c-border-soft);
    scroll-margin-top: 80px;
  }

  .note-item:first-child {
    border-top: none;
    padding-top: 4px;
  }

  .note-item--work {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 22px;
    align-items: start;
  }

  .note-cover {
    border-radius: 10px;
    overflow: hidden;
    background: #eef0f3;
    align-self: start;
  }

  .note-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: contain;
  }

  .note-link {
    display: inline-block;
    margin-top: 12px;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--c-accent);
    color: #fff;
    font-family: var(--ff-sans);
    font-size: 13px;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }

  .note-link:hover {
    opacity: 0.9;
  }

  .note-date {
    margin: 0;
    font-family: var(--ff-mono);
    font-size: 11.5px;
    color: var(--c-text-faint, #999);
  }

  .note-title {
    margin: 4px 0 0;
    font-size: 17px;
    font-weight: 700;
    color: #222;
  }

  .note-body {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.8;
    color: #333;
  }

  .note-body p {
    margin: 0 0 8px;
  }

  .note-body p:last-child {
    margin-bottom: 0;
  }

  .empty {
    color: #666;
    font-size: 14px;
  }

  @media (max-width: 720px) {
    .page-glass {
      padding: 20px 16px;
    }
    .note-item--work {
      grid-template-columns: 1fr;
    }
    .note-cover {
      max-width: 220px;
    }
  }
</style>
